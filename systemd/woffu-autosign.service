[Unit]
Description=Woffu auto clock-in/out
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# Adjust this path to your virtual environment. Schedule settings come from
# ~/.config/woffu/config.json; CLI options can override them if needed.
ExecStart=%h/woffu-helper/.venv/bin/woffu-autosign
